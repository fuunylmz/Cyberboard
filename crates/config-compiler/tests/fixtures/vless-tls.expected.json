{
  "log": { "level": "info", "timestamp": true },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-tls-in",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        { "name": "00000000-0000-0000-0000-000000000002", "uuid": "00000000-0000-0000-0000-000000000002" }
      ],
      "tls": {
        "enabled": true,
        "certificate_path": "/etc/cyberboard/tls/fullchain.pem",
        "key_path": "/etc/cyberboard/tls/privkey.pem"
      }
    }
  ],
  "outbounds": [{ "type": "direct", "tag": "direct" }],
  "route": { "final": "direct" },
  "experimental": {
    "v2ray_api": {
      "listen": "127.0.0.1:10085",
      "stats": { "enabled": true, "users": ["00000000-0000-0000-0000-000000000002"] }
    }
  }
}
